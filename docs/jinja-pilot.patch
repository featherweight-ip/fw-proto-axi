--- a/fw_proto/python/fw_proto_weave/templates/xtors/chans.sv.j2	1970-01-01 00:00:00.000000000 +0000
+++ b/fw_proto/python/fw_proto_weave/templates/xtors/chans.sv.j2	2026-11-12 13:49:32.860744297 +0000
@@ -0,0 +1,28 @@
+// The channel transactors of {{ x.name }}, as virtual interfaces.
+class {{ x.name }}_chans {{ x.b.header }};
+{% for c in x.chans %}
+    typedef {{ c.payload }} {{ c.payload_name }};
+{% endfor %}
+{% for c in x.chans %}
+    virtual fw_rv_{{ c.kind }}_xtor_if #({{ c.payload_name }}) {{ c.name }};
+{% endfor %}
+    function new(
+{%- for c in x.chans %}virtual fw_rv_{{ c.kind }}_xtor_if #({{ c.payload_name }}) {{ c.name }}_{{ ", " if not loop.last }}{% endfor %});
+{% for c in x.chans %}
+        {{ c.name }} = {{ c.name }}_;
+{% endfor %}
+    endfunction
+
+    // Sets one channel's knob by path, "<ch>.{{ x.knobs|join("|") }}". 0 if there is no such knob.
+    function bit set_knob(string path, int unsigned v);
+        case (path)
+{% for c in x.chans %}
+{% for k in x.knobs %}
+            "{{ c.name }}.{{ k }}": {{ c.name }}.{{ k }} = v;
+{% endfor %}
+{% endfor %}
+            default: return 0;
+        endcase
+        return 1;
+    endfunction
+endclass
diff -ruN a/fw_proto/python/fw_proto_weave/templates/xtors/core.sv.j2 b/fw_proto/python/fw_proto_weave/templates/xtors/core.sv.j2
--- a/fw_proto/python/fw_proto_weave/templates/xtors/core.sv.j2	1970-01-01 00:00:00.000000000 +0000
+++ b/fw_proto/python/fw_proto_weave/templates/xtors/core.sv.j2	2026-11-12 13:49:32.860744297 +0000
@@ -0,0 +1,27 @@
+// {{ x.what }}: the synthesizable core. One fw-hdl rv
+// core per channel, the payloads (flat, packed as their structs) spliced onto
+// the pins (names as in the field table and on the protocol checker). The
+// <ch>_up_* links go to the class side ({{ x.name }} adds the rv interfaces).
+module {{ x.name }}_core
+    import {{ x.dp }}::*, {{ x.dp }}_woven::*;
+{{ x.b.header }} (
+{% for p in x.ports(uplink=True) %}
+{{ p }}
+{% endfor %}
+);
+{% for c in x.chans %}
+
+    // {{ c.name }}: {{ c.verb }}
+    localparam int unsigned {{ c.up }}_BITS = {{ c.bits_fn }}({{ x.b.struct_param }});
+{% for m in c.members %}
+    localparam int unsigned {{ c.up }}_{{ m.up }}_LSB = {{ m.lsb }};
+{% endfor %}
+    logic [{{ c.up }}_BITS-1:0] {{ c.name }}_d;
+    fw_rv_{{ c.kind }}_xtor_core #(.W({{ c.up }}_BITS)) u_{{ c.name }} (.clock({{ x.clk }}), .reset({{ x.rst_hi }}), .up_data({{ c.name }}_up_data), .up_valid({{ c.name }}_up_valid),
+{%- if c.kind == "monitor" %} .up_first({{ c.name }}_up_first), .up_xfer({{ c.name }}_up_xfer),{% endif %}
+ .up_ready({{ c.name }}_up_ready), .data({{ c.name }}_d), .valid({{ c.name }}valid), .ready({{ c.name }}ready));
+{% for m in c.members %}
+    assign {{ m.lhs }} = {{ m.rhs }};
+{% endfor %}
+{% endfor %}
+endmodule : {{ x.name }}_core
diff -ruN a/fw_proto/python/fw_proto_weave/templates/xtors/if.sv.j2 b/fw_proto/python/fw_proto_weave/templates/xtors/if.sv.j2
