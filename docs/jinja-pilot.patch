diff -ruN a/fw_proto/python/fw_proto_weave/templates/xtors/module.sv.j2 b/fw_proto/python/fw_proto_weave/templates/xtors/module.sv.j2
--- a/fw_proto/python/fw_proto_weave/templates/xtors/module.sv.j2	1970-01-01 00:00:00.000000000 +0000
+++ b/fw_proto/python/fw_proto_weave/templates/xtors/module.sv.j2	2026-11-12 13:49:32.860744297 +0000
@@ -0,0 +1,31 @@
+// {{ x.what }}. {{ x.name }}_core on the pins, one fw-hdl
+// rv interface per channel on its links (names as in the field table and on
+// the protocol checker, so `.*` connects). The class side is u_if
+// ({{ x.name }}_if), driven by {{ x.name }}_bridge.
+module {{ x.name }}
+    {{ x.imports }}
+{{ x.b.header }} (
+{% for p in x.ports(uplink=False) %}
+{{ p }}
+{% endfor %}
+);
+{% for c in x.chans %}
+    typedef {{ c.payload }} {{ c.payload_name }};
+{% endfor %}
+    {{ x.name }}_if {{ x.b.params_ref }} u_if ();
+{% for c in x.chans %}
+
+    {{ c.payload_name }} {{ c.name }}_up_data;
+    bit {% for s in c.sigs %}{{ c.name }}_{{ s }}{{ ", " if not loop.last }}{% endfor %};
+    fw_rv_{{ c.kind }}_xtor_if #(.T({{ c.payload_name }})) u_{{ c.name }}_if (.clock({{ x.clk }}), .reset({{ x.rst_hi }})
+{%- for s in ["up_data"] + c.sigs %}, .{{ s }}({{ c.name }}_{{ s }}){% endfor %});
+{% endfor %}
+
+    {{ x.name }}_core {{ x.b.params_ref }} u_core (.*
+{%- for c in x.chans %}{% for s in ["up_data"] + c.sigs %}, .{{ c.name }}_{{ s }}({{ c.name }}_{{ s }}){% endfor %}{% endfor %});
+
+    initial begin
+        u_if.chans = new({% for c in x.chans %}u_{{ c.name }}_if{{ ", " if not loop.last }}{% endfor %});
+        u_if.bound = 1;
+    end
+endmodule : {{ x.name }}
diff -ruN a/fw_proto/python/fw_proto_weave/templates/xtors/mon_bridge.sv.j2 b/fw_proto/python/fw_proto_weave/templates/xtors/mon_bridge.sv.j2
--- a/fw_proto/python/fw_proto_weave/templates/xtors/mon_bridge.sv.j2	1970-01-01 00:00:00.000000000 +0000
+++ b/fw_proto/python/fw_proto_weave/templates/xtors/mon_bridge.sv.j2	2026-11-12 13:49:32.860744297 +0000
@@ -0,0 +1,29 @@
+// What {{ x.name }} sees, as listener calls: <ch>_pre on the first valid
+// cycle of a beat, <ch>_post on its handshake. Add listeners to req and rsp.
+class {{ x.name }}_bridge {{ x.b.header }};
+{% for c in x.chans %}
+    typedef {{ x.b.spec(c.api) }}::{{ c.payload_name }} {{ c.payload_name }};
+{% endfor %}
+    {{ x.vif }} vif;
+    {{ x.b.spec(x.req + "_listener_fanout") }} req = new();
+    {{ x.b.spec(x.rsp + "_listener_fanout") }} rsp = new();
+
+    function new({{ x.vif }} vif_);
+        this.vif = vif_;
+    endfunction
+
+    virtual task run();
+        wait (vif.bound);
+        fork
+{% for c in x.chans %}
+            forever begin
+                {{ c.payload_name }} t;
+                bit first, xfer;
+                vif.chans.{{ c.name }}.get_ev(t, first, xfer);
+                if (first) {{ c.fan }}.{{ c.name }}_pre(t);
+                if (xfer) {{ c.fan }}.{{ c.name }}_post(t);
+            end
+{% endfor %}
+        join
+    endtask
+endclass
diff -ruN a/fw_proto/python/fw_proto_weave/templates/xtors/role_bridge.sv.j2 b/fw_proto/python/fw_proto_weave/templates/xtors/role_bridge.sv.j2
--- a/fw_proto/python/fw_proto_weave/templates/xtors/role_bridge.sv.j2	1970-01-01 00:00:00.000000000 +0000
+++ b/fw_proto/python/fw_proto_weave/templates/xtors/role_bridge.sv.j2	2026-11-12 13:49:32.860744297 +0000
@@ -0,0 +1,34 @@
+// The pins of {{ x.name }} as the {{ x.role }}'s channel API: {{ x.out_api }} goes out through
+// the rv initiators; run() passes each beat the pins receive to {{ x.in_var }} ({{ x.in_api }}).
+class {{ x.name }}_bridge {{ x.b.header }} implements {{ x.b.spec(x.out_api) }};
+{% for c in x.sends %}
+    typedef {{ x.b.spec(x.out_api) }}::{{ c.payload_name }} {{ c.payload_name }};
+{% endfor %}
+{% for c in x.recvs %}
+    typedef {{ x.b.spec(x.in_api) }}::{{ c.payload_name }} {{ c.payload_name }};
+{% endfor %}
+    {{ x.vif }} vif;
+    {{ x.b.spec(x.in_api) }} {{ x.in_var }};
+
+    function new({{ x.vif }} vif_, {{ x.b.spec(x.in_api) }} {{ x.in_var[2:] }} = null);
+        this.vif = vif_;
+        {{ x.in_var }} = {{ x.in_var[2:] }};
+    endfunction
+{% for c in x.sends %}
+
+    virtual task {{ c.name }}(input {{ c.payload_name }} t);
+        wait (vif.bound);
+        vif.chans.{{ c.name }}.send(t);
+    endtask
+{% endfor %}
+
+    // One loop per received channel, so a stalled channel holds up no other.
+    virtual task run();
+        wait (vif.bound);
+        fork
+{% for c in x.recvs %}
+            forever begin {{ c.payload_name }} t; vif.chans.{{ c.name }}.recv(t); {{ x.in_var }}.{{ c.name }}(t); end
+{% endfor %}
+        join
+    endtask
+endclass
